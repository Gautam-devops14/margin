# Copy this file to .env and fill in your own values.
# Only VITE_-prefixed vars reach the browser — Vite ignores anything else.
# NEVER put the Supabase secret key or the Gemini key in here or in .env:
# they belong in Supabase secrets, server-side only.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key-here
